---
import '../styles/global.css';
import PhotoViewer from '../components/PhotoViewer.astro';
import { siteName, href } from '../data/site.js';
const {title=siteName, description='A personal photographic journal of quiet places, passing light, and things worth remembering.'} = Astro.props;
const links=[['Stories','/stories/'],['Journal','/journal/'],['Archive','/archive/'],['About','/about/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#F7F7F4" />
  <meta name="description" content={description} />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <title>{title === siteName ? title : title + ' — ' + siteName}</title>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" id="site-header">
  <div class="nav-wrap">
    <a class="wordmark" href={href('/')}>THE THINGS I KEPT<span class="period">.</span></a>
    <nav class="desktop-links" aria-label="Primary">{links.map(([label,url]) => <a href={href(url)} aria-current={Astro.url.pathname.startsWith(href(url)) ? 'page' : undefined}>{label}</a>)}</nav>
    <details class="mobile-menu"><summary aria-label="Open navigation">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile">{links.map(([label,url]) => <a href={href(url)} aria-current={Astro.url.pathname.startsWith(href(url)) ? 'page' : undefined}>{label}</a>)}</nav></details>
  </div>
</header>
<main id="main-content"><slot /></main>
<footer class="site-footer"><div><span>THE THINGS I KEPT.</span><p>A personal archive of photographs and passing moments.</p></div><div class="footer-links"><a href={href('/stories/')}>Stories</a><a href={href('/journal/')}>Journal</a><a href={href('/archive/')}>Archive</a></div><small>© {new Date().getFullYear()} · An ongoing collection.</small></footer>
<PhotoViewer />
<script>
  const header = document.getElementById('site-header');
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
    targets.forEach((element) => {
      element.classList.add('reveal-ready');
      observer.observe(element);
    });
  }
</script>
</body>
</html>
