---
import Layout from '../layouts/BaseLayout.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import PhotoMedia from '../components/PhotoMedia.astro';
import StorySequence from '../components/StorySequence.astro';
import { render, getEntry } from 'astro:content';
import { href } from '../data/site.js';
import {
  dateLabel, getPhotoCatalog, getPublishedStories, getPublishedJournal,
  photoFrom, validateContent, visiblePhotoIds
} from '../lib/content.js';

export async function getStaticPaths() {
  const [stories, journal] = await Promise.all([getPublishedStories(), getPublishedJournal()]);
  return [
    ...['stories', 'journal', 'archive', 'about'].map((slug) => ({ params: { slug } })),
    ...stories.map((entry) => ({ params: { slug: 'stories/' + entry.id }, props: { storyEntry: entry } })),
    ...journal.map((entry) => ({ params: { slug: 'journal/' + entry.id }, props: { journalEntry: entry } })),
  ];
}

const { storyEntry, journalEntry } = Astro.props;
const slug = Astro.params.slug;
const isStories = slug === 'stories';
const isJournal = slug === 'journal';
const isArchive = slug === 'archive';
const isAbout = slug === 'about';

const [stories, journal, catalog] = await Promise.all([
  getPublishedStories(), getPublishedJournal(), getPhotoCatalog()
]);
validateContent(stories, journal, catalog);

const entry = storyEntry || journalEntry;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const aboutPage = isAbout ? await getEntry('pages', 'about') : null;
const aboutRendered = aboutPage ? await render(aboutPage) : null;
const AboutContent = aboutRendered?.Content;

const pageTitle =
  storyEntry?.data.title || journalEntry?.data.title ||
  (isStories ? 'Stories' : isJournal ? 'Journal' : isArchive ? 'Archive' : 'About');

const archive = visiblePhotoIds(stories, journal)
  .map((id) => photoFrom(catalog, id, 'archive'))
  .sort((a, b) => b.year - a.year || a.id.localeCompare(b.id));
const years = [...new Set(archive.map((photo) => photo.year))].sort((a, b) => b - a);
const categories = [...new Set(archive.map((photo) => photo.category))].sort();
const storyCover = (story) => photoFrom(catalog, story.data.cover);
const journalCover = (entry) => photoFrom(catalog, entry.data.photos[0]);
---
<Layout title={pageTitle}>
  {storyEntry ? <>
    <div class="container page-heading">
      <a class="back-link" href={href('/stories/')}>← All stories</a>
      <div class="eyebrow">{storyEntry.data.category} · {storyEntry.data.period}</div>
      <h1>{storyEntry.data.title}</h1>
      <p>{storyEntry.data.description}</p>
    </div>
    {Content && <div class="container story-prose prose"><Content /></div>}
    <StorySequence sequence={storyEntry.data.sequence} catalog={catalog} />
    <div class="container sequence-end"><a class="text-link" href={href('/stories/')}>← Back to stories</a></div>
  </> : journalEntry ? <>
    <div class="container page-heading journal-heading">
      <a class="back-link" href={href('/journal/')}>← Journal</a>
      <div class="eyebrow">{dateLabel(journalEntry.data.date).toUpperCase()}</div>
      <h1>{journalEntry.data.title}</h1>
      <p>{journalEntry.data.description}</p>
    </div>
    <PhotoFrame photo={journalCover(journalEntry)} className="container journal-hero" loading="eager" />
    {Content && <article class="reading-column prose"><Content /></article>}
    {journalEntry.data.photos.length > 1 && <div class="container journal-photo-grid">
      {journalEntry.data.photos.slice(1).map((id) => <PhotoFrame photo={photoFrom(catalog, id)} className="aspect-portrait" />)}
    </div>}
    <div class="container sequence-end"><a class="text-link" href={href('/journal/')}>← All journal entries</a></div>
  </> : isStories ? <>
    <section class="container page-heading">
      <div class="eyebrow">CURATED PHOTOGRAPHS</div><h1>Stories</h1>
      <p>Photographs sequenced into small exhibitions. Each collection has its own rhythm, and its own reason for being.</p>
    </section>
    <section class="container story-grid listing">
      {stories.map((story) => <a class="story-card" href={href('/stories/' + story.id + '/')}>
        <div class={'image-block aspect-portrait ' + storyCover(story).tone}><PhotoMedia photo={storyCover(story)} /></div>
        <h3>{story.data.title}</h3>
        <p>{story.data.category} · {story.data.period}</p>
        <small>{story.data.description}</small>
      </a>)}
    </section>
  </> : isJournal ? <>
    <section class="container page-heading">
      <div class="eyebrow">CHRONICLES OF ORDINARY LIFE</div><h1>Journal</h1>
      <p>Fragments of days, places, conversations, and ordinary light.</p>
    </section>
    <section class="container journal-list">
      {journal.map((entry) => <a class="journal-item" href={href('/journal/' + entry.id + '/')}>
        <div class={'image-block ' + journalCover(entry).tone}><PhotoMedia photo={journalCover(entry)} /></div>
        <div><div class="eyebrow">{dateLabel(entry.data.date)}</div>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.description}</p>
          <span class="subtle-link">Read entry ↗</span>
        </div>
      </a>)}
    </section>
  </> : isArchive ? <>
    <section class="container page-heading">
      <div class="eyebrow">A GROWING COLLECTION</div><h1>Archive</h1>
      <p>A place to wander through the years, and return to what I once noticed.</p>
    </section>
    <section class="container archive-section">
      <div class="archive-toolbar">
        <div class="archive-filter-group" aria-label="Filter by year">
          <span>Year</span>
          <div class="archive-filters">
            <button type="button" class="filter active" data-filter-type="year" data-value="all" aria-pressed="true">All</button>
            {years.map((year) => <button type="button" class="filter" data-filter-type="year" data-value={year} aria-pressed="false">{year}</button>)}
          </div>
        </div>
        <div class="archive-filter-group" aria-label="Filter by category">
          <span>Subject</span>
          <div class="archive-filters">
            <button type="button" class="filter active" data-filter-type="category" data-value="all" aria-pressed="true">All</button>
            {categories.map((category) => <button type="button" class="filter" data-filter-type="category" data-value={category.toLowerCase()} aria-pressed="false">{category}</button>)}
          </div>
        </div>
      </div>
      <p class="archive-result" data-archive-result>{archive.length} photographs</p>
      <div class="archive-grid">
        {archive.map((photo) => <PhotoFrame photo={photo} className="archive-tile" />)}
      </div>
    </section>
    <script>
      const state = { year: 'all', category: 'all' };
      const controls = document.querySelectorAll('[data-filter-type].filter');
      const items = document.querySelectorAll('.archive-tile');
      const result = document.querySelector('[data-archive-result]');
      controls.forEach((button) => button.addEventListener('click', () => {
        const kind = button.dataset.filterType;
        state[kind] = button.dataset.value;
        controls.forEach((control) => {
          const selected = control.dataset.value === state[control.dataset.filterType] &&
            control.dataset.filterType === kind;
          if (control.dataset.filterType === kind) {
            control.classList.toggle('active', selected);
            control.setAttribute('aria-pressed', String(selected));
          }
        });
        let visible = 0;
        items.forEach((item) => {
          const shown = (state.year === 'all' || item.dataset.year === state.year) &&
            (state.category === 'all' || item.dataset.category === state.category);
          item.hidden = !shown;
          if (shown) visible++;
        });
        if (result) result.textContent = visible + (visible === 1 ? ' photograph' : ' photographs');
      }));
    </script>
  </> : isAbout ? <>
    <section class="container page-heading about-page">
      <div class="eyebrow">{aboutPage?.data.eyebrow || 'BEHIND THE CAMERA'}</div>
      <h1>{aboutPage?.data.title || 'About this place.'}</h1>
      <p>{aboutPage?.data.description}</p>
      <div class="about-divider"></div>
      {AboutContent && <article class="prose about-prose"><AboutContent /></article>}
    </section>
  </> : null}
</Layout>
