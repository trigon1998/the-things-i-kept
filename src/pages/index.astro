---
import Layout from '../layouts/BaseLayout.astro';
import {stories,journal,href} from '../data/site.js';
---
<Layout>
<section class="container hero-intro" data-reveal><div class="eyebrow">A PERSONAL PHOTOGRAPHIC JOURNAL</div><h1>The quiet things<br/><em>I noticed.</em></h1><p>Photographs, places, people, passing light — and the moments I chose to keep.</p></section>
<button type="button" class="wide image-block hero-image water" data-viewable data-tone="water" data-caption="A quiet morning — photograph placeholder" aria-label="View feature photograph"><span class="photo-label">A quiet morning / photo placeholder</span></button>
<div class="container image-credit"><span>SELECTED PHOTOGRAPH · 2026</span><span>001 / AN ONGOING COLLECTION</span></div>
<section class="container section-block" data-reveal><div class="section-top"><div><div class="eyebrow">01 / CURATED PHOTOGRAPHS</div><h2>Selected stories</h2></div><a class="subtle-link" href={href('/stories/')}>Explore all stories <span>↗</span></a></div><div class="story-grid">{stories.slice(0,2).map((s,i)=><a class="story-card" href={href('/stories/'+s.slug+'/')}><div class={'image-block '+s.tones[0]+' aspect-portrait'}><span class="photo-label">{s.title} / photo placeholder</span></div><h3>{s.title}</h3><p>{s.eyebrow}</p></a>)}</div></section>
<section class="journal-feature" data-reveal><div class="container feature-inner"><div><div class="eyebrow">02 / FROM THE JOURNAL</div><h2>Little things<br/><em>worth remembering.</em></h2><p>Not every photograph needs to be a project. Some simply belong to the day they were made.</p><a class="text-link" href={href('/journal/')}>Read the journal <span>↗</span></a></div><div class="image-block room aspect-square"><span class="photo-label">Everyday / photo placeholder</span></div></div></section>
<section class="container section-block archive-teaser" data-reveal><div class="eyebrow">03 / LOOK BACK</div><h2>An archive that grows<br/>with time.</h2><p>A place to revisit what I have seen, and perhaps see it differently.</p><a class="text-link" href={href('/archive/')}>Enter the archive <span>↗</span></a></section>
</Layout>
