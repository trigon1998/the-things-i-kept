---
import Layout from '../layouts/BaseLayout.astro';
import CinematicSequence from '../components/CinematicSequence.astro';
import PhotoMedia from '../components/PhotoMedia.astro';
import '../styles/cinematic.css';
import { href } from '../data/site.js';
import siteContent from '../data/site-content.json';
import {
  getPhotoCatalog, getPublishedStories, getPublishedJournal,
  validateContent, photoFrom, visiblePhotoIds, dateLabel
} from '../lib/content.js';

const [stories, journal, catalog] = await Promise.all([
  getPublishedStories(), getPublishedJournal(), getPhotoCatalog()
]);
validateContent(stories, journal, catalog);

const curatedStories = [
  ...stories.filter((item) => item.data.featured),
  ...stories.filter((item) => !item.data.featured)
].slice(0, 3);

const chapters = siteContent.cinema.chapters.map((chapter, index) => ({
  ...chapter,
  photo: photoFrom(catalog, chapter.photoId, 'cinematic homepage chapter ' + (index + 1)),
}));

const journalEntry = journal.find((item) => item.data.featured) || journal[0];
const journalPhoto = journalEntry ? photoFrom(catalog, journalEntry.data.photos[0]) : null;
const years = [...new Set(visiblePhotoIds(stories, journal).map((id) => photoFrom(catalog, id).year))]
  .sort((a, b) => b - a).slice(0, 4);
---
<Layout description="A personal photographic journal: people, places, light, and the things I chose to keep.">
  <section class="cinema-intro" aria-labelledby="homepage-title">
    <div class="cinema-intro-top">
      <span class="cinema-eyebrow">{siteContent.hero.eyebrow}</span>
      <span class="cinema-intro-number">VOL. 01 / A LIVING ARCHIVE</span>
    </div>
    <div class="cinema-intro-body">
      <h1 class="cinema-intro-title" id="homepage-title">
        {siteContent.hero.titleLine1}<br /><em>{siteContent.hero.titleLine2}</em>
      </h1>
      <p class="cinema-intro-deck">{siteContent.hero.description}</p>
    </div>
    <div class="cinema-intro-bottom">
      <a class="cinema-enter" href="#cinematic-journey">
        <span class="cinema-enter-arrow" aria-hidden="true">↓</span>
        <span>Enter the photographs</span>
      </a>
      <span class="cinema-intro-aside">A quiet place to look closer.<br />Scroll to discover.</span>
    </div>
  </section>

  {chapters.length > 0 && <CinematicSequence scenes={chapters} />}

  <section class="cinema-interlude" aria-label="A moment of reflection" data-reveal>
    <div class="cinema-interlude-inner">
      <span class="cinema-eyebrow">{siteContent.interlude.eyebrow}</span>
      <p>{siteContent.interlude.line1}<br />{siteContent.interlude.line2}</p>
      <span class="cinema-small-rule" aria-hidden="true"></span>
    </div>
  </section>

  <section class="cinema-section" id="selected-stories" aria-labelledby="stories-title">
    <div class="cinema-section-heading" data-reveal>
      <div>
        <span class="cinema-eyebrow">01 / CURATED PHOTOGRAPHS</span>
        <h2 id="stories-title">{siteContent.labels.stories}<span class="sr-only"> — Photographic essays</span></h2>
      </div>
      <p>Some photographs belong together. Their order, the quiet between them, and the memories they hold become a story of their own.</p>
    </div>
    <div class="cinema-home-story-grid">
      {curatedStories.map((story, index) => {
        const cover = photoFrom(catalog, story.data.cover);
        return (
          <a href={href('/stories/' + story.id + '/')} class="cinema-home-story" data-reveal>
            <div class={'cinema-home-story-visual ' + cover.tone}>
              <PhotoMedia photo={cover} />
            </div>
            <div class="cinema-home-story-text">
              <div>
                <span class="cinema-eyebrow">{story.data.category} / {story.data.period}</span>
                <h3>{story.data.title}</h3>
                <p>{story.data.description}</p>
              </div>
              <span class="cinema-home-story-index">{String(index + 1).padStart(2, '0')} ↗</span>
            </div>
          </a>
        );
      })}
    </div>
    <div class="cinema-all-stories"><a href={href('/stories/')}>View all stories <span aria-hidden="true">↗</span></a></div>
  </section>

  {journalEntry && journalPhoto && (
    <section class="cinema-journal" aria-labelledby="journal-title">
      <div class="cinema-journal-layout">
        <a class={'cinema-journal-image ' + journalPhoto.tone} href={href('/journal/' + journalEntry.id + '/')}
          aria-label={'Read journal entry: ' + journalEntry.data.title} data-reveal>
          <PhotoMedia photo={journalPhoto} />
        </a>
        <div class="cinema-journal-copy" data-reveal>
          <span class="cinema-eyebrow">02 / FROM THE JOURNAL</span>
          <h2 id="journal-title">{siteContent.labels.journalLine1}<br /><em>{siteContent.labels.journalLine2}</em></h2>
          <p>{journalEntry.data.description}</p>
          <div class="cinema-journal-title">{dateLabel(journalEntry.data.date)} · {journalEntry.data.title}</div>
          <a class="text-link" href={href('/journal/' + journalEntry.id + '/')}>Read the entry <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="cinema-archive" aria-labelledby="archive-title" data-reveal>
    <span class="cinema-eyebrow">03 / THE LIVING ARCHIVE</span>
    <h2 id="archive-title">{siteContent.labels.archiveLine1}<br /><em>{siteContent.labels.archiveLine2}</em></h2>
    <p>{siteContent.labels.archiveDescription}</p>
    {years.length > 0 && <div class="cinema-years" aria-label="Years represented in the archive">
      {years.map((year) => <span>{year}</span>)}
    </div>}
    <a href={href('/archive/')}>Explore the archive <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
