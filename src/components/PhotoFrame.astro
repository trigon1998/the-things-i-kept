---
/**
 * PhotoFrame is the editable bridge between the current placeholders
 * and future real photographs. Pass src (with the GitHub Pages base path)
 * to display an actual image without changing the Photo Viewer.
 */
const {
  tone = 'mist',
  className = '',
  caption = '',
  label = 'Photograph placeholder',
  year,
  src,
  alt = '',
  loading = 'lazy'
} = Astro.props;
---
<button
  type="button"
  class={'image-block photo-trigger ' + tone + ' ' + className}
  data-viewable
  data-tone={tone}
  data-caption={caption}
  data-photo-src={src}
  data-year={year}
  aria-label={'View photograph: ' + (caption || alt || label)}
>
  {src ? (
    <img src={src} alt={alt} loading={loading} decoding="async" />
  ) : (
    <span class="photo-label" aria-hidden="true">{label}</span>
  )}
</button>
