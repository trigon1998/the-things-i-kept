---
import { href } from '../data/site.js';
import PhotoMedia from './PhotoMedia.astro';

const { photo, className = '', loading = 'lazy' } = Astro.props;
const fullSrc = photo.src ? href(photo.src) : undefined;
const caption = photo.caption || photo.title;
---
<button
  type="button"
  class={'image-block photo-trigger ' + photo.tone + ' ' + className}
  data-viewable
  data-tone={photo.tone}
  data-photo-src={fullSrc}
  data-caption={caption}
  data-year={photo.year}
  data-category={photo.category.toLowerCase()}
  aria-label={'View photograph: ' + (caption || photo.alt || photo.id)}
>
  <PhotoMedia photo={photo} loading={loading} />
</button>
